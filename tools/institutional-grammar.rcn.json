      "w": 170,
      "h": 80,
      "shape": "rect",
      "color": "#ffffff",
      "icon": "rcn_agreement",
      "props": {
        "text": "Gardeners must water only on assigned days and must not use sprinklers, but may hand-water seedlings any day. Violators lose watering privileges for a week."
      },
      "schemaLabel": "Statement"
    },
    {
      "fontSize": 12,
      "fontColor": "#000000",
      "borderColor": "#000000",
      "borderWidth": 3,
      "borderDash": "solid",
      "note": "Gardeners must not water on days not assigned to them, unless hand-watering seedlings. As written this read \"must water only on assigned days\", which hides a MUST NOT inside a MUST. The \"unless\" settles its clash with the seedlings permission.",
      "extraLabels": [],
      "id": "s1",
