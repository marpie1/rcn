  "edges": [
    {
      "id": "e4",
      "src": "n2",
      "tgt": "n3",
      "label": "Whole consists of Part",
      "type": "lg_struct",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Aggregation-participation. Drawn whole → part, and the whole is also the sentence subject. Solid triangle at the whole."
    },
    {
      "id": "e7",
      "src": "n5",
      "tgt": "n6",
      "label": "Exhibitor exhibits Feature",
      "type": "lg_struct",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Exhibition-characterization. Converse reading: the Feature CHARACTERIZES the Exhibitor. A feature that is an object is an attribute; one that is a process is an operation. This is the only fundamental structural relation that allows all four object/process combinations."
    },
    {
      "id": "e10",
      "src": "n8",
      "tgt": "n9",
      "label": "Specific is a General",
      "type": "lg_struct_rev",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Generalization-specialization. Drawn general → specific, but the SPECIFIC is the sentence subject — the words run against the arrow."
    },
    {
      "id": "e13",
      "src": "n11",
      "tgt": "n12",
      "label": "Instance is an instance of Class",
      "type": "lg_struct_rev",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Classification-instantiation. Drawn class → instance; the INSTANCE is the sentence subject. Answers \"which particular one\", where is-a-type-of answers \"which kind\"."
    },
    {
      "id": "e16",
      "src": "n14",
      "tgt": "n15",
      "label": "A  ‹your words›  B",
      "type": "lg_struct",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Tagged structural link: you supply the phrase, e.g. \"communicates via\" in the OnStar example. Unidirectional or bidirectional. Use it when no fundamental relation fits — not as a way to avoid choosing one."
    },
    {
      "id": "e20",
      "src": "n18",
      "tgt": "n19",
      "label": "Agent handles Process",
      "type": "lg_proc",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Agent link — a human or organisation that does it. Filled circle at the process end. Only people and groups are agents."
    },
    {
      "id": "e23",
      "src": "n21",
      "tgt": "n22",
      "label": "Process requires Instrument",
      "type": "lg_proc_rev",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Instrument link — a tool the process needs and does not consume. Drawn instrument → process, but the PROCESS is the sentence subject. Open circle at the process end."
    },
    {
      "id": "e26",
      "src": "n24",
      "tgt": "n25",
      "label": "Process consumes Object",
      "type": "lg_proc_rev",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Consumption link — the object ceases to exist. Drawn object → process; the process is the sentence subject."
    },
    {
      "id": "e29",
      "src": "n27",
      "tgt": "n28",
      "label": "Process yields Object",
      "type": "lg_proc",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Result link — the object comes into existence."
    },
    {
      "id": "e32",
      "src": "n30",
      "tgt": "n31",
      "label": "Process affects Object",
      "type": "lg_proc",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Effect link — the object survives but changes state. Shorthand for a consumption and a result on the same object; use the state-level pair when the states matter."
    },
    {
      "id": "e35",
      "src": "n33",
      "tgt": "n34",
      "label": "Object initiates Process",
      "type": "lg_proc",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Event link — an object entering a state triggers the process."
    },
    {
      "id": "e38",
      "src": "n36",
      "tgt": "n37",
      "label": "A invokes B",
      "type": "lg_proc",
      "fontSize": 13,
      "width": 2,
      "curved": false,
      "note": "Invocation link — when A ends it starts B. The one procedural link that runs process to process."
    }
  ],
