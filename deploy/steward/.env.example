# Copy to .env and choose a password. It is the only secret in the stack and it
# never leaves this computer.
NEO4J_PASSWORD=change-me

# Neo4j edition. Enterprise under developer terms is the default (what Neo4j
# Desktop installs); it is for your own machine only. For a server other people
# reach, use Community — neo4j:5.26-community — and read the README first.
# NEO4J_IMAGE=neo4j:5.26-enterprise
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
