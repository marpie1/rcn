FROM node:lts-slim

# Pinned deliberately. wiki 0.27.0 (wiki-server 0.20.1) is the version the SCP
# plugins were developed and tested against, and it discovers plugins by
# scanning node_modules for wiki-plugin-* directories.
#
# Do not float this to latest. wiki-server 0.27.0 (in wiki 0.40.x) changed
# discovery to read wiki's own package.json dependencies instead, which silently
# ignores every plugin here — they stay on disk and are never served, with no
# error at boot. Upgrading means reworking how the plugins are installed.
RUN npm install -g wiki@0.27.0

# Install all 19 SCP plugins into wiki's node_modules directory.
COPY scp/plugins/ /tmp/scp-plugins/
RUN for d in /tmp/scp-plugins/*/; do \
      name=$(basename "$d"); \
      cp -r "$d" "/usr/local/lib/node_modules/wiki/node_modules/$name"; \
    done && rm -rf /tmp/scp-plugins

EXPOSE 3000

# FedWiki writes page data to /root/.wiki inside the container.
# Mount a named volume there — patient data persists across image rebuilds.
CMD ["wiki", "--port", "3000"]
