# RCN Shared Care Plan — Caddy reverse proxy
# Domain names are read from the .env file.
# Caddy handles TLS automatically via Let's Encrypt.

{
    email {env.ACME_EMAIL}
}

{env.WIKI_DOMAIN} {
    reverse_proxy fedwiki:3000
}

{env.GROOVE_DOMAIN} {
    reverse_proxy groove:3001
}

{env.PROXY_DOMAIN} {
    reverse_proxy sofi-proxy:8765
}
