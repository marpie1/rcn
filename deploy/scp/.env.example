# ──────────────────────────────────────────────────────────────
# RCN Shared Care Plan — environment configuration
# Copy this file to .env and fill in every value before deploying.
# ──────────────────────────────────────────────────────────────

# Domain names for this NDC site.
# All three must have DNS A records pointing to this server's public IP
# before you run docker compose up (Caddy needs live DNS to get TLS certs).
WIKI_DOMAIN=wiki.yourndc.example.com
GROOVE_DOMAIN=groove.yourndc.example.com
PROXY_DOMAIN=proxy.yourndc.example.com

# Email address for Let's Encrypt certificate notifications.
ACME_EMAIL=your@email.com

# Anthropic API key — required for AI-assisted tools.
# Obtain from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret between browser tools and the proxy server.
# Generate a fresh value with:  openssl rand -hex 32
# This value must also be set in the browser tool config (Marc Pierson handles this).
SODOTO_PROXY_SECRET=
