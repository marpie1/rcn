FROM node:lts-slim

WORKDIR /app

# Install dependencies first (cached layer — only re-runs if package.json changes)
COPY groove-workspace/package*.json ./
RUN npm install --production

# Copy application source
COPY groove-workspace/ .

# Ensure data directory exists (will be replaced by mounted volume at runtime)
RUN mkdir -p server/data

EXPOSE 3001

CMD ["node", "server/index.js"]
