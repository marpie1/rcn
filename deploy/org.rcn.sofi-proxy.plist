<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.rcn.sofi-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/marcpierson/rcn/sofi-proxy.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/marcpierson/rcn</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>REPLACE_ME</string>
    <key>HOME</key>
    <string>/Users/marcpierson</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/marcpierson/Library/Logs/sofi-proxy.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/marcpierson/Library/Logs/sofi-proxy.log</string>
</dict>
</plist>
