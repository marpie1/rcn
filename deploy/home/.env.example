# Copy this to .env, then run ./set-passphrase.sh

# Your own Anthropic API key — from console.anthropic.com.
# This is what keeps your health data yours: the call goes from your computer
# to Anthropic under your account. It does not pass through RCN.
ANTHROPIC_API_KEY=sk-ant-

# The passphrase that opens the gate. Do not fill these in by hand —
# ./set-passphrase.sh writes them, because the hash has to be escaped in a
# particular way or docker compose will silently mangle it.
#
# Only the hash is stored. The passphrase itself is written down nowhere, so
# nobody can recover it for you. Keep it somewhere safe.
GATE_USER=me
GATE_PASSWORD_HASH=

# Where encrypted backups are written, and how many to keep.
# Backups are unreadable without the passphrase, so this can be a folder that
# syncs to Dropbox or iCloud — that is the point of encrypting them.
BACKUP_DIR=./backups
BACKUP_KEEP=8
