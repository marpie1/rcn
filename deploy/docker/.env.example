# ──────────────────────────────────────────────────────────────
# RCN SODOTO — environment configuration
# Copy this file to .env and fill in every value before deploying.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────

# Domain names for this SODOTO install.
# Both must have DNS records pointing at this server before you run
# docker compose up (Caddy needs live DNS to obtain TLS certificates).
SODOTO_DOMAIN=sodoto.yourndc.example.com
WIKI_DOMAIN=wiki-sodoto.yourndc.example.com

# Email address for Let's Encrypt certificate notifications.
ACME_EMAIL=your@email.com

# Public URL of the proxy — the issuer tool reads this from /config.
# Normally https:// followed by SODOTO_DOMAIN above.
PROXY_URL=https://sodoto.yourndc.example.com

# FedWiki site that holds the portfolios and the badge ledger.
WIKI_SITE=localhost

# Anthropic API key — required for AI-assisted features.
# Use a key created just for this server so it can be revoked on its own.
ANTHROPIC_API_KEY=sk-ant-...

# Operator passphrase guarding the admin API endpoints.
# Generate a fresh value with:  openssl rand -hex 32
# Operators type this into the browser once; the proxy never serves it.
SODOTO_PROXY_SECRET=
