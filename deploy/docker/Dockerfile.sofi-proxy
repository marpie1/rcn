FROM python:3.12-slim

WORKDIR /app

# Copy all rcn files so sofi-proxy can serve them as static files
# (.dockerignore at repo root excludes secrets and large files)
COPY . .

EXPOSE 8765

# Seed the demo cast (idempotent, opt-in via SEED_DEMO), then start the proxy.
# The `;` — not `&&` — means a seed hiccup never blocks the proxy from starting.
# seed.py no-ops unless SEED_DEMO is set, and never overwrites existing content.
CMD ["sh", "-c", "python3 sodoto/seed/seed.py; exec python3 sofi-proxy.py"]
