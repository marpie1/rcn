FROM python:3.12-slim

WORKDIR /app

# Python block-buffers stdout when it is not a terminal, so under Docker the
# proxy's audit lines — page writes, badge writes, provisioning, DENIED — sat in
# the process buffer instead of reaching the logs. Four site provisions produced
# zero log lines on WikiCafe (Christian, Aug 2026). An audit trail that is only
# flushed when the buffer happens to fill is not an audit trail.
ENV PYTHONUNBUFFERED=1

# Copy all rcn files so sofi-proxy can serve them as static files
# (.dockerignore at repo root excludes secrets and large files)
COPY . .

EXPOSE 8765

# Seed the demo cast (idempotent, opt-in via SEED_DEMO), then start the proxy.
# The `;` — not `&&` — means a seed hiccup never blocks the proxy from starting.
# seed.py no-ops unless SEED_DEMO is set, and never overwrites existing content.
CMD ["sh", "-c", "python3 sodoto/seed/seed.py; exec python3 sofi-proxy.py"]
