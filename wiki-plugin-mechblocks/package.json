{
  "name": "wiki-plugin-mechblocks",
  "version": "0.1.0",
  "description": "Federated Wiki plugin: edit Ward Cunningham's Mech scripts as blocks, watch the shared notebook fill as a script runs, draw its graphs in the RCN Graph Tool, and answer PLUGIN rcn with Layer 1 and SODOTO badge blocks",
  "keywords": [
    "wiki",
    "federated wiki",
    "plugin",
    "mech",
    "rcn",
    "blocks"
  ],
  "author": "RCN Network <rcn@relocalizecreativity.net>",
  "license": "MIT",
  "main": "index.js",
  "files": [
    "client/mechblocks.js",
    "server",
    "factory.json",
    "index.js",
    "pages",
    "README.md",
    "LICENSE",
    "vendor/mech/LICENSE",
    "vendor/mech/README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/server.test.js test/client.test.mjs",
    "prepack": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "marked": "^18.0.5",
    "universal-ticker": "^0.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marpie1/rcn.git"
  },
  "homepage": "https://github.com/marpie1/rcn/tree/master/wiki-plugin-mechblocks",
  "engines": {
    "node": ">=18"
  }
}
