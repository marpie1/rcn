{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Option Box Fact Box",
  "type": "object",
  "required": ["decision", "options"],
  "properties": {
    "decision": {
      "type": "object",
      "required": ["problem", "question", "time_horizon", "denominator"],
      "properties": {
        "problem":              { "type": "string" },
        "problem_code":         { "type": ["string", "null"], "description": "SNOMED code if available" },
        "question":             { "type": "string", "description": "Plain-language statement of the choice" },
        "pretest_probability":  { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "time_horizon":         { "type": "string", "description": "e.g. '5 years' — every number below is per this horizon" },
        "denominator":          { "type": "integer", "minimum": 1, "description": "Shared denominator for all frequencies" }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "type"],
        "properties": {
          "id":      { "type": "string" },
          "label":   { "type": "string", "description": "Plain language, e.g. 'Take apixaban daily'" },
          "type":    { "type": "string", "enum": ["drug", "test", "procedure", "watchful_waiting"] },
          "rxnorm":  { "type": ["string", "null"], "description": "RxCUI if drug, else null" },
          "benefits": {
            "type": "array",
            "items": { "$ref": "#/definitions/outcome_benefit" }
          },
          "harms": {
            "type": "array",
            "items": { "$ref": "#/definitions/outcome_harm" }
          },
          "burden": {
            "type": "string",
            "description": "Visits, monitoring, cost class, daily-life load"
          },
          "unknowns": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Explicit statements of what is not known"
          }
        }
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["basis", "grade", "source"],
      "properties": {
        "basis":              { "type": "string", "enum": ["RCT", "meta-analysis", "observational", "label", "expert"] },
        "grade":              { "type": "string", "enum": ["high", "moderate", "low", "very_low"] },
        "source":             { "type": "string" },
        "funding":            { "type": "string", "enum": ["industry", "public", "mixed", "unknown"] },
        "population_caveat":  { "type": ["string", "null"] }
      }
    },
    "rac": {
      "type": "object",
      "required": ["severity", "probability", "code"],
      "properties": {
        "severity":    { "type": "string", "enum": ["I", "II", "III", "IV"], "description": "I=minor II=moderate III=major IV=catastrophic" },
        "probability": { "type": "string", "enum": ["A", "B", "C", "D"],    "description": "A=rare B=unlikely C=possible D=likely" },
        "code":        { "type": "string", "description": "Derived cell, e.g. '3C'" }
      }
    },
    "outcome_benefit": {
      "type": "object",
      "required": ["outcome", "with_option", "without_option"],
      "properties": {
        "outcome":        { "type": "string" },
        "with_option":    { "type": "number", "description": "Events per denominator with this option" },
        "without_option": { "type": "number", "description": "Events per denominator without this option" },
        "nnt":            { "type": ["number", "null"] },
        "evidence":       { "$ref": "#/definitions/evidence" }
      }
    },
    "outcome_harm": {
      "type": "object",
      "required": ["outcome", "with_option", "without_option"],
      "properties": {
        "outcome":        { "type": "string" },
        "with_option":    { "type": "number" },
        "without_option": { "type": "number" },
        "nnh":            { "type": ["number", "null"] },
        "rac":            { "$ref": "#/definitions/rac" },
        "cascade":        { "type": ["string", "null"] },
        "evidence":       { "$ref": "#/definitions/evidence" }
      }
    }
  }
}
