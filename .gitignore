# Private keys — never commit
veramo/keys.json

# Copyrighted book content — do not publish
Chase/
Chase alias

# Python bytecode
__pycache__/

# Node dependencies, anywhere in the tree. Repo-wide on purpose: several
# subprojects (scp/plugins/*, sodoto/plugins/*) carry a package.json but no
# .gitignore of their own, so an npm install there would otherwise leave
# node_modules untracked-and-unignored, one `git add -A` from history.
node_modules/

# Office temp lock files
~$*
docs/~$*

# Claude Code worktrees
.claude/worktrees/
# Personal Claude Code settings (command allow-list, local paths): never shared.
.claude/settings.local.json

# Personal-install secrets and backups — never commit these
deploy/home/.env
deploy/home/backups/
deploy/home/store.sparsebundle

# Filled-in environment files anywhere — only .env.example is tracked.
# This repo is public; a real .env carries the proxy passphrase and API key.
# The .env.* form matters: plain `.env` does NOT match `.env.neo4j`, which
# holds the substrate database password.
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Generated single-file map bundle (rebuild: python3 maps/build_standalone_map.py)
maps/rcn_map_standalone.html
maps/dist-assets/

# SODOTO demo private seeds — throwaway, but keep the no-committed-keys habit
sodoto/seed/demo-keys.json

# TheBrain exports — someone else's address book, and this repo is public.
# A brain holds named real people, home addresses, phone numbers and meeting
# times. Convert with `python3 tools/brain-to-graph.py` and keep both the export
# and whatever it produces out of history. Put new exports in brain-exports/.
*.brz
brain-exports/
Carl's March Brain */

# Build output from tools/build-deploy-tool.js — regenerable, keep it out of history.
dist/

# Claude Chat full export — 124 MB JSON plus the zips; the extracted transcripts next to it are tracked
Design Record/chat-export/conversations-000/
Design Record/chat-export/*.zip
# login IPs and phone number
Design Record/chat-export/light_metadata-000/

# Derived from Neo4j, which is derived from files (decision 17). Regenerate with
# python3 substrate/export.py --bundle <db...>; never the only copy of anything.
substrate/export/
