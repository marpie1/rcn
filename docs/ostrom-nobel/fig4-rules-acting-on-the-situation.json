      "color": "#ffffff",
      "fontColor": "#000000",
      "fontSize": 16,
      "borderColor": "#000000",
      "borderWidth": 1.5,
      "borderDash": "solid",
      "note": "Game element (iii): the set of actions actors can take at specific points.\n\nSet by choice rules. Plain question: what is each role allowed, required, or forbidden to do?",
      "extraLabels": [],
      "props": {}
    },
    {
      "id": "info",
      "label": "INFORMATION\nabout",
      "x": 650,
      "y": 360,
