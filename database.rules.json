{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      "$sessionId": {
        ".read": "$sessionId.matches(/^[A-Z0-9]{6}$/)",
        "$participantKey": {
          ".write": "$sessionId.matches(/^[A-Z0-9]{6}$/)"
        }
      }
    },

    "topics": {
      "$sessionId": {
        ".read":  "$sessionId.matches(/^[A-Z0-9]{6}$/)",
        ".write": "$sessionId.matches(/^[A-Z0-9]{6}$/)"
      }
    },

    "panas": {
      "$sessionId": {
        ".read": "$sessionId.matches(/^[A-Z0-9]{6}$/)",
        "$participantKey": {
          ".write": "$sessionId.matches(/^[A-Z0-9]{6}$/)"
        }
      }
    }
  }
}
