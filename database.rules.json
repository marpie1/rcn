{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      "$sessionId": {
        ".read": "$sessionId.matches(/^[A-Z0-9]{6}$/)",
        "$participantKey": {
          ".write": "auth != null && $sessionId.matches(/^[A-Z0-9]{6}$/) && ($participantKey === auth.uid || newData.val() === null || $participantKey === 'models' || $participantKey === 'modelOrder' || $participantKey === 'customModels')"
        }
      }
    },

    "topics": {
      "$sessionId": {
        ".read":  "$sessionId.matches(/^[A-Z0-9]{6}$/)",
        ".write": "auth != null && $sessionId.matches(/^[A-Z0-9]{6}$/)"
      }
    },

    "panas": {
      "$sessionId": {
        ".read": "$sessionId.matches(/^[A-Z0-9]{6}$/)",
        "$participantKey": {
          ".write": "auth != null && $sessionId.matches(/^[A-Z0-9]{6}$/) && ($participantKey === auth.uid || newData.val() === null)"
        }
      }
    }
  }
}
